# EmailAuto Configuration
# Copy this file to .env and fill in your values

# ====================
# Email Provider
# ====================
# Choose: "outlook" or "gmail"
EMAILAUTO_PROVIDER=outlook

# ====================
# Outlook Configuration (if using Outlook)
# ====================
# Get these from Azure Portal > App registrations
OUTLOOK_CLIENT_ID=your-client-id-here
OUTLOOK_TENANT_ID=consumers
# Refresh token (obtained after first auth, store in GitHub Secrets for CI)
OUTLOOK_REFRESH_TOKEN=

# Outlook email filter (OData $filter syntax)
# Examples: "isRead eq false", "importance eq 'high'"
EMAILAUTO_OUTLOOK_QUERY=isRead eq false

# ====================
# Gmail Configuration (if using Gmail - legacy)
# ====================
# Gmail query filter
EMAILAUTO_GMAIL_QUERY=is:unread

# ====================
# LLM Configuration
# ====================
# Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Model to use (default: gemini-2.0-flash for free tier)
EMAILAUTO_MODEL=gemini-2.0-flash

# OpenAI API key (legacy, optional fallback)
# OPENAI_API_KEY=

# ====================
# General Settings
# ====================
# Your name (used in email signatures)
EMAILAUTO_USER_NAME=Your Name

# Email signature to append to drafts
EMAILAUTO_USER_SIGNATURE=Best regards

# Tone for AI-generated replies
EMAILAUTO_DEFAULT_TONE=warm, concise, professional

# Maximum emails to process per run
EMAILAUTO_MAX_CONTEXT_EMAILS=12

# Skip drafts for emails older than this many days
EMAILAUTO_MAX_DRAFT_AGE_DAYS=3

# Maximum API calls per run (budget limit)
EMAILAUTO_MAX_API_CALLS=10
